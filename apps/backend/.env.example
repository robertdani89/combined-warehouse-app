# SQL Server settings
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# Optional SQL Server connection settings
MSSQL_PORT=1433
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true

# Optional connection pool tuning
MSSQL_POOL_MAX=10
MSSQL_POOL_MIN=0
MSSQL_POOL_IDLE_MS=30000

# Frontend origin for CORS (comma-separated values are supported)
FRONTEND_URL=http://localhost:8081
